library(tidyverse)
library(phyloseq)
library(microbiome)
library(ggVennDiagram)
load("hiv_final.RData")
#convert the file to relative abundance.
mpt_RA <- transform_sample_counts(hiv_final, fun=function(x) x/sum(x))
#bin person by IL-6 level: <5pg/mL or >5pg/mL
#included "sample_data" command here because I was having issues with making this command
#actually bin stuff.
lowil6 <- subset_samples(mpt_RA, sample_data(mpt_RA)$'IL.6_pg_mL' <= 5)
highil6 <- subset_samples(mpt_RA, sample_data(mpt_RA)$'IL.6_pg_mL' >= 5)
#let's ask, which ASVs are in >70% of samples of the subsets?
low_ASVs <- core_members(lowil6, detection=0, prevalence = 0.7)
high_ASVs <- core_members(highil6, detection=0, prevalence = 0.7)
#Identify ASVs which we just filtered
prune_taxa(low_ASVs,mpt_final) %>%
tax_table()
#Identify ASVs which we just filtered
prune_taxa(low_ASVs,hiv_final) %>%
tax_table()
tax_table(prune_taxa(noanti_ASVs,mpt_final))
#Identify ASVs which we just filtered
prune_taxa(low_ASVs,hiv_final) %>%
tax_table()
tax_table(prune_taxa(high_ASVs,hiv_final))
#Identify ASVs which we just filtered and plot them
prune_taxa(high_ASVs,hiv_final) %>%
plot_bar(fill="Genus") +
facet_wrap(.~`IL.6_pg_mL`, scales ="free")
#Identify ASVs which we just filtered and plot them
prune_taxa(high_ASVs,hiv_final) %>%
plot_bar(fill="Genus") +
facet_wrap(.~`IL.6_pg_mL`, scales ="free")
intersect(low_ASVs, high_ASVs)
#Venn Diagram
il_6list <- list(IL-6high = high_ASVs, IL-6low = low_ASVs)
#Venn Diagram
il_6list <- list(IL6high = high_ASVs, IL6low = low_ASVs)
first_venn <- ggVennDiagram(x = il_6list)
first_venn
#Venn Diagram
il_6list <- list(IL6high = high_ASVs, IL6low = low_ASVs)
first_venn <- ggVennDiagram(x = il_6list) + ggtile("Core ASVs in IL6 High vs Low groups (70% prevalence), all patient")
#Venn Diagram
il_6list <- list(IL6high = high_ASVs, IL6low = low_ASVs)
first_venn <- ggVennDiagram(x = il_6list) + ggtitle("Core ASVs in IL6 High vs Low groups (70% prevalence), all patient")
first_venn
#Venn Diagram
il_6list <- list(IL6high = high_ASVs, IL6low = low_ASVs)
first_venn <- ggVennDiagram(x = il_6list) + ggtitle("Core ASVs in IL6 High vs Low groups\n(70% prevalence), all patient")
first_venn
#Venn Diagram
il_6list <- list(IL6high = high_ASVs, IL6low = low_ASVs)
allpatientvenn1 <- ggVennDiagram(x = il_6list) + ggtitle("Core ASVs in IL6 High vs Low groups\n(70% prevalence), all patients")
ggsave("allpatientvenn1", allpatientvenn1)
il_6list <- list(IL6high = high_ASVs, IL6low = low_ASVs)
allpatientvenn2 <- ggVennDiagram(x = il_6list) + ggtitle("Core ASVs in IL6 High vs Low groups\n(50% prevalence), all patients")
allpatientvenn2
